{
  "name": "valca",
  "version": "0.5.0",
  "description": "AI coding security co-pilot — blocks insecure code at generation time",
  "author": {
    "name": "Prem Kumar Akula"
  },
  "license": "BUSL-1.1",
  "repository": "https://github.com/vigilsec-io/cordon",
  "keywords": ["security", "iac", "docker", "secrets", "linter", "devsecops"],
  "hooks": {
    "PostToolUse": {
      "matcher": "Write|Edit|MultiEdit",
      "type": "command",
      "command": "plugin/hook.sh",
      "description": "Scans every file written by Claude for security issues. Exits 2 on CRITICAL/HIGH to block the write inline."
    }
  },
  "install": {
    "steps": [
      "pip install valca",
      "valca init"
    ],
    "global_steps": [
      "pip install valca",
      "valca init --global"
    ]
  }
}
