{
  "name": "vigil-security",
  "displayName": "Valca Security",
  "description": "AI coding security co-pilot \u2014 blocks insecure code at generation time. Catches docker-compose port exposure, secrets, AI agent patterns, and more.",
  "version": "0.4.1",
  "publisher": "vigilsec",
  "license": "BUSL-1.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Linters"
  ],
  "keywords": [
    "security",
    "docker",
    "devsecops",
    "ai",
    "linter",
    "secrets"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/PranLabs/valca"
  },
  "homepage": "https://github.com/PranLabs/valca",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vigil.scanFile",
        "title": "Valca: Scan Current File"
      },
      {
        "command": "vigil.scanWorkspace",
        "title": "Valca: Scan Workspace"
      }
    ],
    "configuration": {
      "title": "Valca Security",
      "properties": {
        "vigil.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Valca security scanning."
        },
        "vigil.scanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically scan files when saved."
        },
        "vigil.executablePath": {
          "type": "string",
          "default": "",
          "description": "Path to the vigil executable. Leave empty to auto-detect from PATH. Example: /usr/local/bin/vigil"
        },
        "vigil.minSeverity": {
          "type": "string",
          "enum": [
            "CRITICAL",
            "HIGH",
            "MEDIUM",
            "LOW",
            "INFO"
          ],
          "default": "HIGH",
          "description": "Minimum severity level to show in the Problems panel."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "26.1.0",
    "@types/vscode": "1.125.0",
    "@vscode/vsce": "3.9.2",
    "typescript": "7.0.2"
  }
}
